# Nebula Assistant — environment variables
# Copy to .env.local for development. See README.md → "Environment variables".

# ── Public (inlined into the browser bundle) ─────────────────────────────────
# Supabase project URL: Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable key (sb_publishable_…) or legacy anon key. Safe to expose:
# every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Canonical origin of this deployment, used for auth redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: public source repository. Open-source links are hidden when empty.
NEXT_PUBLIC_REPO_URL=

# ── Server-only (never prefix with NEXT_PUBLIC_) ─────────────────────────────
# 32 random bytes, base64-encoded. Encrypts users' provider API keys at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it makes previously saved keys unreadable (users re-enter them).
NEBULA_ENCRYPTION_KEY=
